# AI Service Configuration
# ==========================

# Choose your AI provider: clarifai, openai, or custom
AI_PROVIDER=clarifai

# Port to run the service
PORT=5000

# Flask environment (development or production)
FLASK_ENV=development

# ============================================
# OPTION 1: Clarifai (Recommended for Food)
# ============================================
# Get free API key: https://clarifai.com/
# Food recognition model is built-in and free

AI_API_KEY=your_clarifai_api_key_here
CLARIFAI_APP_ID=your_app_id (optional)
CLARIFAI_MODEL_ID=food-item-recognition

# ============================================
# OPTION 2: OpenAI GPT-4 Vision
# ============================================
# Get API key: https://platform.openai.com/
# Requires credits, more expensive but very accurate

OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# OPTION 3: Custom AI API
# ============================================
# Use your own AI API endpoint

AI_API_KEY=your_custom_api_key_here
AI_API_URL=https://your-ai-api.com/classify

# ============================================
# Testing without AI (Heuristic Mode)
# ============================================
# Set AI_PROVIDER=default to use simple heuristics
# No API key needed, but less accurate

# AI_PROVIDER=default
